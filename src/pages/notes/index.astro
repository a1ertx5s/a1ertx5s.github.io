---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const all = (await getCollection('notes')).filter((note) => !note.data.draft);

const KIND_LABEL: Record<string, string> = {
	book: '书籍',
	article: '文章',
	paper: '论文',
	document: '文档',
};
const STATUS_LABEL: Record<string, string> = {
	reading: '在读',
	done: '已读完',
	paused: '搁置',
};

// 按 group 归档，未分组的落到「其它」
interface Group {
	name: string;
	order: number;
	items: typeof all;
}

const groupMap = new Map<string, Group>();
for (const note of all) {
	const name = note.data.group ?? '其它';
	const order = note.data.groupOrder ?? 999;
	if (!groupMap.has(name)) groupMap.set(name, { name, order, items: [] });
	groupMap.get(name)!.items.push(note);
}

const groups = [...groupMap.values()].sort((a, b) => a.order - b.order || a.name.localeCompare(b.name));
for (const group of groups) {
	group.items.sort(
		(a, b) =>
			(a.data.order ?? 999) - (b.data.order ?? 999) ||
			a.data.title.localeCompare(b.data.title, 'zh-CN'),
	);
}

const total = all.length;
const annotated = all.filter((note) => (note.data.annotations?.length ?? 0) > 0).length;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文库 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.page-head {
				margin-bottom: 2em;
			}
			.page-head h1 {
				margin-bottom: 0.3em;
			}
			.page-head p {
				color: rgb(var(--gray));
				margin: 0;
				max-width: 46em;
			}
			.stats {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-top: 1.2em;
			}
			.stat {
				font-size: 0.82em;
				color: rgb(var(--gray));
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				padding: 0.25em 0.9em;
				background: #fff;
			}
			.group {
				margin-bottom: 2.6em;
			}
			.group-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				border-bottom: 2px solid rgb(var(--gray-light));
				padding-bottom: 0.5em;
				margin-bottom: 1.1em;
			}
			.group-head h2 {
				margin: 0;
				font-size: 1.3em;
			}
			.group-head span {
				font-size: 0.82em;
				color: rgb(var(--gray));
			}
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 0.7em;
			}
			li a {
				display: flex;
				flex-direction: column;
				gap: 0.3em;
				height: 100%;
				box-sizing: border-box;
				text-decoration: none;
				color: inherit;
				padding: 0.85em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				background: #fff;
				transition: 0.16s ease;
			}
			li a:hover {
				border-color: var(--accent);
				box-shadow: var(--box-shadow);
				transform: translateY(-2px);
			}
			.title {
				font-weight: 700;
				color: rgb(var(--black));
				line-height: 1.45;
			}
			.sub {
				font-size: 0.8em;
				color: rgb(var(--gray));
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				align-items: center;
			}
			.tag {
				color: var(--accent);
			}
			.dot {
				color: rgb(var(--gray-light));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-head">
				<h1>文库</h1>
				<p>
					我读过的原文和写在正文上的批注。所有内容都是仓库里的 Markdown，
					批注写在文件的 frontmatter 里，构建时直接渲染进正文 —— 页面是只读的。
				</p>
				<div class="stats">
					<span class="stat">共 {total} 篇</span>
					<span class="stat">{groups.length} 个分组</span>
					{annotated > 0 && <span class="stat">{annotated} 篇有批注</span>}
				</div>
			</section>

			{
				groups.map((group) => (
					<section class="group">
						<div class="group-head">
							<h2>{group.name}</h2>
							<span>{group.items.length} 篇</span>
						</div>
						<ul>
							{group.items.map((note) => (
								<li>
									<a href={`/notes/${note.id}/`}>
										<span class="title">{note.data.title}</span>
										<span class="sub">
											{note.data.author && (
												<>
													<span>{note.data.author}</span>
													<span class="dot">·</span>
												</>
											)}
											<span>{KIND_LABEL[note.data.kind] ?? note.data.kind}</span>
											{note.data.status && (
												<>
													<span class="dot">·</span>
													<span>{STATUS_LABEL[note.data.status] ?? note.data.status}</span>
												</>
											)}
											{(note.data.annotations?.length ?? 0) > 0 && (
												<>
													<span class="dot">·</span>
													<span class="tag">{note.data.annotations!.length} 条批注</span>
												</>
											)}
											{!note.data.group && note.data.importedDate && (
												<>
													<span class="dot">·</span>
													<FormattedDate date={note.data.importedDate} />
												</>
											)}
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
