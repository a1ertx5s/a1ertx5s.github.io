---
/**
 * 可批注的文档容器。
 * 左侧是文档正文（slot），右侧是批注列表；选中文字即可划线并写批注。
 */
interface Props {
	docId: string;
	title?: string;
	/** 是否尝试加载仓库中预置的批注 JSON */
	loadRemote?: boolean;
}

const { docId, title = '', loadRemote = true } = Astro.props;
---

<div
	class="annotator"
	data-annotator
	data-doc-id={docId}
	data-title={title}
	data-load-remote={loadRemote ? '1' : '0'}
>
	<div class="annotator__layout">
		<article class="annotator__doc prose" data-annotator-root>
			<slot />
		</article>

		<aside class="annotator__side" data-annotator-side data-annotator-ui aria-label="批注列表">
			<div class="side-card">
				<div class="side-head">
					<h2>我的批注</h2>
					<span class="side-status" data-annotator-status>还没有批注</span>
				</div>

				<p class="side-hint" data-annotator-empty>
					在左侧正文里<strong>选中任意文字</strong>，点浮动按钮即可划线并写下批注。
				</p>

				<div class="side-list" data-annotator-list></div>

				<div class="side-actions">
					<label class="btn-mini">
						导入 JSON
						<input type="file" accept="application/json,.json" data-annotator-import hidden />
					</label>
					<button type="button" class="btn-mini" data-annotator-export-json>导出 JSON</button>
					<button type="button" class="btn-mini" data-annotator-export-md>导出 Markdown</button>
					<button type="button" class="btn-mini btn-mini--danger" data-annotator-clear>清空</button>
				</div>

				<p class="side-tip">
					批注保存在浏览器本地（localStorage）。换设备时用「导出 JSON」带走，再在新设备「导入 JSON」即可。
				</p>
			</div>
		</aside>
	</div>

	<!-- 选中文字后出现的浮动按钮 -->
	<div class="annotator-toolbar" data-annotator-toolbar data-annotator-ui hidden>
		<button type="button" class="btn-annotate" data-annotator-create>
			<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
				<path
					fill="currentColor"
					d="M11.5 1.5a2.12 2.12 0 0 1 3 3L6 13l-4 1 1-4 8.5-8.5Zm1.6 1.4a.62.62 0 0 0-.88 0L4.5 10.6l-.4 1.6 1.6-.4 7.7-7.7a.62.62 0 0 0 0-.88Z"
				></path>
			</svg>
			划线并批注
		</button>
	</div>

	<!-- 批注编辑浮层 -->
	<div class="annotator-popover" data-annotator-popover data-annotator-ui hidden>
		<div class="popover-quote" data-annotator-quote></div>
		<textarea data-annotator-note rows="4" placeholder="写下你的想法……（Ctrl/Cmd + Enter 保存）"></textarea>
		<div class="popover-colors" role="group" aria-label="高亮颜色">
			<button type="button" class="swatch" data-annotator-color="yellow" title="黄色" aria-label="黄色"></button>
			<button type="button" class="swatch" data-annotator-color="green" title="绿色" aria-label="绿色"></button>
			<button type="button" class="swatch" data-annotator-color="blue" title="蓝色" aria-label="蓝色"></button>
			<button type="button" class="swatch" data-annotator-color="pink" title="粉色" aria-label="粉色"></button>
		</div>
		<div class="popover-actions">
			<button type="button" class="btn-mini btn-mini--danger" data-annotator-delete>删除</button>
			<span class="spacer"></span>
			<button type="button" class="btn-mini" data-annotator-close>取消</button>
			<button type="button" class="btn-mini btn-mini--primary" data-annotator-save>保存</button>
		</div>
	</div>
</div>

<script>
	import { initAnnotator, type AnnotatorController } from '../lib/annotator';

	function boot() {
		const el = document.querySelector<HTMLElement>('[data-annotator]');
		if (!el || el.dataset.annotatorReady === '1') return;

		const controller = initAnnotator({
			container: el,
			docId: el.dataset.docId ?? 'document',
			title: el.dataset.title ?? '',
			loadRemote: el.dataset.loadRemote !== '0',
		});

		el.dataset.annotatorReady = '1';
		(window as unknown as { __annotator?: AnnotatorController }).__annotator = controller;
		document.dispatchEvent(new CustomEvent('annotator:ready', { detail: controller }));
	}

	// 与 Astro View Transitions 共存：每次导航后重新初始化
	document.addEventListener('astro:page-load', boot);
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', boot);
	} else {
		boot();
	}

	// Ctrl/Cmd + Enter 保存批注
	document.addEventListener('keydown', (event) => {
		if ((event.metaKey || event.ctrlKey) && event.key === 'Enter') {
			const note = document.querySelector<HTMLTextAreaElement>('[data-annotator-note]');
			if (note && document.activeElement === note) {
				event.preventDefault();
				document.querySelector<HTMLButtonElement>('[data-annotator-save]')?.click();
			}
		}
	});
</script>

<style>
	.annotator__layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		gap: 2.5em;
		align-items: start;
		max-width: 1180px;
		margin: 0 auto;
	}
	.annotator__doc {
		min-width: 0;
	}
	.annotator__side {
		position: sticky;
		top: 5.5em;
	}
	.side-card {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
		background: #fff;
		padding: 1.1em;
		box-shadow: 0 1px 3px rgba(var(--gray), 10%);
	}
	.side-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5em;
		margin-bottom: 0.75em;
	}
	.side-head h2 {
		font-size: 1.05em;
		margin: 0;
	}
	.side-status {
		font-size: 0.78em;
		color: rgb(var(--gray));
	}
	.side-hint,
	.side-tip {
		font-size: 0.82em;
		line-height: 1.7;
		color: rgb(var(--gray));
		margin: 0 0 0.9em;
	}
	.side-tip {
		margin: 0.9em 0 0;
		padding-top: 0.75em;
		border-top: 1px dashed rgb(var(--gray-light));
	}
	.side-list {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
		max-height: 46vh;
		overflow: auto;
	}
	:global(.note-item) {
		display: block;
		width: 100%;
		text-align: left;
		border: 1px solid rgb(var(--gray-light));
		border-left: 3px solid var(--hl-yellow, #f5c518);
		border-radius: 10px;
		background: #fff;
		padding: 0.55em 0.7em;
		cursor: pointer;
		font: inherit;
		line-height: 1.55;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
	}
	:global(.note-item:hover) {
		border-color: var(--accent);
		transform: translateX(-2px);
	}
	:global(.note-item[data-color='green']) {
		border-left-color: #4caf50;
	}
	:global(.note-item[data-color='blue']) {
		border-left-color: #2196f3;
	}
	:global(.note-item[data-color='pink']) {
		border-left-color: #ec407a;
	}
	:global(.note-item__quote) {
		display: block;
		font-size: 0.84em;
		color: rgb(var(--black));
	}
	:global(.note-item__text) {
		display: block;
		font-size: 0.78em;
		color: rgb(var(--gray));
		margin-top: 0.25em;
	}
	.side-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin-top: 0.9em;
	}
	.btn-mini {
		font: inherit;
		font-size: 0.76em;
		padding: 0.35em 0.7em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: #fff;
		color: rgb(var(--gray-dark));
		cursor: pointer;
		transition: 0.15s ease;
	}
	.btn-mini:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.btn-mini--primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}
	.btn-mini--primary:hover {
		background: var(--accent-dark);
		color: #fff;
	}
	.btn-mini--danger:hover {
		border-color: #e5484d;
		color: #e5484d;
	}

	/* ---------- 浮动按钮 ---------- */
	.annotator-toolbar {
		position: fixed;
		z-index: 60;
	}
	.btn-annotate {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font: inherit;
		font-size: 0.82em;
		font-weight: 600;
		padding: 0.45em 0.9em;
		border: none;
		border-radius: 999px;
		background: rgb(var(--black));
		color: #fff;
		cursor: pointer;
		box-shadow: 0 6px 20px rgba(var(--black), 30%);
	}
	.btn-annotate:hover {
		background: var(--accent);
	}

	/* ---------- 批注浮层 ---------- */
	.annotator-popover {
		position: fixed;
		z-index: 70;
		width: min(360px, calc(100vw - 24px));
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
		padding: 0.9em;
		box-shadow: 0 12px 40px rgba(var(--black), 22%);
	}
	.popover-quote {
		font-size: 0.8em;
		line-height: 1.6;
		color: rgb(var(--gray));
		border-left: 3px solid var(--hl-yellow, #f5c518);
		padding-left: 0.6em;
		margin-bottom: 0.6em;
		max-height: 5.2em;
		overflow: auto;
	}
	.annotator-popover textarea {
		width: 100%;
		box-sizing: border-box;
		font: inherit;
		font-size: 0.86em;
		line-height: 1.6;
		padding: 0.55em 0.65em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		resize: vertical;
		color: rgb(var(--black));
	}
	.annotator-popover textarea:focus {
		outline: 2px solid var(--accent);
		outline-offset: -1px;
	}
	.popover-colors {
		display: flex;
		gap: 0.4em;
		margin: 0.6em 0;
	}
	.swatch {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		border: 2px solid transparent;
		cursor: pointer;
		padding: 0;
	}
	.swatch[data-annotator-color='yellow'] {
		background: var(--hl-yellow, #f5c518);
	}
	.swatch[data-annotator-color='green'] {
		background: #4caf50;
	}
	.swatch[data-annotator-color='blue'] {
		background: #2196f3;
	}
	.swatch[data-annotator-color='pink'] {
		background: #ec407a;
	}
	.swatch.is-active {
		border-color: rgb(var(--black));
	}
	.popover-actions {
		display: flex;
		align-items: center;
		gap: 0.4em;
	}
	.spacer {
		flex: 1;
	}

	@media (max-width: 980px) {
		.annotator__layout {
			grid-template-columns: minmax(0, 1fr);
			gap: 2em;
		}
		.annotator__side {
			position: static;
		}
		.side-list {
			max-height: none;
		}
	}
</style>
